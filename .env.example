# =================================================================
# NEURONET CLOUD CONFIGURATION TEMPLATE
# Copy this file to .env and supply your credentials.
# =================================================================

# 1. Google Gemini API Keys (Multi-Key Pool: up to 5 keys supported)
GOOGLE_API_KEY_1=your_gemini_api_key_1_here
GOOGLE_API_KEY_2=your_gemini_api_key_2_here
GOOGLE_API_KEY_3=your_gemini_api_key_3_here
GOOGLE_API_KEY_4=your_gemini_api_key_4_here
GOOGLE_API_KEY_5=your_gemini_api_key_5_here
# Optional fallback if single key is used:
GOOGLE_API_KEY=your_single_gemini_api_key_here

# 2. Supabase Cloud Configuration (BaaS Database & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# 3. MongoDB Atlas Configuration (DBaaS & Distributed TTL Cache)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# 4. Flask Application Security
FLASK_SECRET_KEY=generate_a_cryptographically_secure_random_key_here
